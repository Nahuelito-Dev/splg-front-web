{
  "name": "splg-app-admin",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --port 3001",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src --ext ts,tsx --report-unused-disable-directives --max-warnings 0",
    "colors": "node scripts/check-colors.mjs",
    "test": "TZ=America/Argentina/Buenos_Aires vitest run",
    "test:utc": "SPLG_TEST_TZ=UTC TZ=UTC vitest run",
    "api:types": "node scripts/generate-types.mjs",
    "verify": "npm run typecheck && npm run lint && npm run format:check && npm run colors && npm run test && vite build",
    "format": "prettier --write src",
    "format:check": "prettier --check src"
  },
  "dependencies": {
    "@emotion/react": "^11.11.1",
    "@emotion/styled": "^11.11.0",
    "@geoman-io/leaflet-geoman-free": "^2.20.2",
    "@hookform/resolvers": "^3.10.0",
    "@mui/icons-material": "^5.14.11",
    "@mui/material": "^5.14.11",
    "@mui/x-data-grid": "^6.16.0",
    "@reduxjs/toolkit": "^2.2.3",
    "@tanstack/react-query": "^5.104.0",
    "autoprefixer": "^10.4.16",
    "axios": "^1.13.4",
    "firebase": "^10.4.0",
    "leaflet": "^1.9.4",
    "lucide-react": "^1.48.0",
    "notistack": "^3.0.2",
    "postcss": "^8.4.33",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-hook-form": "^7.71.1",
    "react-leaflet": "^4.2.1",
    "react-redux": "^9.1.1",
    "react-router-dom": "^6.16.0",
    "recharts": "^3.7.0",
    "socket.io-client": "^4.8.1",
    "tailwindcss": "^3.4.1",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^14.3.1",
    "@types/leaflet": "^1.9.21",
    "@types/react": "^18.2.15",
    "@types/react-dom": "^18.2.7",
    "@typescript-eslint/eslint-plugin": "^6.0.0",
    "@typescript-eslint/parser": "^6.0.0",
    "@vitejs/plugin-react": "^4.0.3",
    "eslint": "^8.45.0",
    "eslint-plugin-react-hooks": "^4.6.0",
    "eslint-plugin-react-refresh": "^0.4.3",
    "jsdom": "^24.1.3",
    "openapi-typescript": "^7.13.0",
    "prettier": "^3.9.9",
    "typescript": "^5.0.2",
    "vite": "^4.4.5",
    "vitest": "^1.6.1"
  }
}
