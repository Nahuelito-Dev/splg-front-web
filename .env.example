# Copiar a .env y completar. El .env no se versiona.
VITE_APP_API_URL=http://localhost:3000/api
VITE_APP_SOCKET_URL=http://localhost:3000
VITE_GOOGLE_MAPS_API_KEY=

# Sentry (proyecto splg-frontend de wagners-labs). Sin DSN, Sentry no se inicializa.
# VITE_SENTRY_DSN=
# Entorno en Sentry; si falta, el mode de Vite (development / production).
# VITE_SENTRY_ENVIRONMENT=
# Session Replay: APAGADO por defecto. Sólo se prende con true. El evento Meta de la grabación (rrweb) guarda la
# URL completa con la query (búsquedas por DNI o teléfono) y el SDK no deja filtrarlo; lo demás sí se filtra.
# VITE_SENTRY_REPLAY=
